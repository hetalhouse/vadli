{
  "name": "@hetalhouse/vadli",
  "version": "0.1.0",
  "description": "Turn a Google Drive folder of photos and videos into a drifting, clickable, shareable cloud",
  "license": "MIT",
  "author": "Brady House <bradyhouse@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hetalhouse/vadli.git"
  },
  "bugs": {
    "url": "https://github.com/hetalhouse/vadli/issues"
  },
  "homepage": "https://github.com/hetalhouse/vadli#readme",
  "keywords": [
    "google-drive",
    "photo-gallery",
    "photo-cloud",
    "video",
    "share-link",
    "hetalhouse"
  ],
  "type": "module",
  "main": "dist/vadli.umd.cjs",
  "module": "dist/vadli.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vadli.js",
      "require": "./dist/vadli.umd.cjs"
    },
    "./style": "./dist/vadli.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
